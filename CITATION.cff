    given-names: Tiago
    email: tresoldi@gmail.com
    # orcid: https://orcid.org/0000-0000-0000-0000
license: MIT
repository-code: https://github.com/tresoldi/matview
url: https://tresoldi.github.io/matview/
keywords:
  - cache
  - build system
  - dependency graph
  - memoization
  - reproducibility
  - sqlite
